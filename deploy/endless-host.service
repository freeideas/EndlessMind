# systemd unit for the Endless Mind host at https://relay.endlessmind.com/ on ordinarydata.
# Install: sudo cp deploy/endless-host.service /etc/systemd/system/ && sudo systemctl enable --now endless-host
# One program does every job there: Endless Maze is its resident game, it relays for games on other
# computers, and it serves an EntryPortal. Caddy passes relay.endlessmind.com and every name under it
# to 127.0.0.1:8790; see deploy/README.md.

[Unit]
Description=Endless Mind host: Endless Maze, a relay and an EntryPortal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ace
Group=ace
WorkingDirectory=/home/ace/Desktop/prjx/EveryGame
Environment=HOME=/home/ace
ExecStart=/home/ace/.local/bin/deno run --allow-read --allow-write --allow-net --allow-run host/main.js host --base https://relay.endlessmind.com/ --game examples/maze --port 8790
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
