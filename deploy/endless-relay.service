# systemd unit for the Endless Mind relay at https://relay.endlessmind.com/ on ordinarydata.
# Install: sudo cp deploy/endless-relay.service /etc/systemd/system/ && sudo systemctl enable --now endless-relay
# Caddy passes relay.endlessmind.com and every name under it to 127.0.0.1:8790; see deploy/README.md.
# It is a host with no game and no EntryPortal of its own, so all it does is relay.

[Unit]
Description=Endless Mind relay: passes players to games on their makers' computers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ace
Group=ace
WorkingDirectory=/home/ace/Desktop/prjx/EveryGame
Environment=HOME=/home/ace
ExecStart=/home/ace/.local/bin/deno run --allow-read --allow-write --allow-net --allow-run host/main.js host --base https://relay.endlessmind.com/ --port 8790 --no-portal
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
