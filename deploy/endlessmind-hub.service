[Unit]
Description=Endless Mind helper server (play.endlessmind.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ace
Group=ace
WorkingDirectory=/home/ace/Desktop/prjx/EveryGame
Environment=PATH=/home/ace/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ace/.local/bin/deno task start --hostname 127.0.0.1 --port 8750 --origin https://play.endlessmind.com
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
