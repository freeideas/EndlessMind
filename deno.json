{
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-run --allow-net --allow-env tests/",
    "check": "deno check shared/*.js realm/*.js host/*.js examples/*/*.js deploy/*.js tests/*.js",
    "portal": "deno run --allow-read --allow-write deploy/entryportal.js",
    "browser": "uv run tests/browser/loop_test.py",
    "run": "deno run --allow-read --allow-write --allow-net --allow-run host/main.js run",
    "maze": "deno task run examples/maze",
    "monster": "deno task run examples/monster",
    "pack": "deno run --allow-read --allow-write host/main.js pack",
    "host": "deno run --allow-read --allow-write --allow-net --allow-run host/main.js host"
  },
  "compilerOptions": {
    "checkJs": true,
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "fmt": {
    "lineWidth": 100
  }
}
