.DS_Store
# A game keeps its data (its secret phrase, progress, records) in .data/ inside its own folder.
.data/
# The host program keeps releases, their data and its own secret phrase here.
.endlessmind/
# Rust builds leave this behind.
target/
# Python leaves these behind.
__pycache__/
# deploy/package.py builds the packages here.
dist/
